# Gradle: caches, and the build output of every loader and target (jars land in build/<target>/libs and dist/)
.gradle/
build/
dist/

# Dev runs (the loaders create these next to their build files)
run/
runs/
logs/
*.log
hs_err_pid*

# Generated by the editors, they are recreated when the project is opened (ModDevGradle writes loaders/neoforge/.vscode)
.vscode/
.idea/
*.iml
.classpath
.project
.settings/
.factorypath
bin/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Never commit local credentials
*.env
